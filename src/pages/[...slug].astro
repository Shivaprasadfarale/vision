---
// TEMPORARY baseline route: renders the original container markup for pages
// that have not yet been converted to components.
import BaseLayout from "../layouts/BaseLayout.astro";
import { allPages } from "../lib/pages";

export function getStaticPaths() {
  return allPages()
    .filter((p) => p.key !== "404")
    .map((p) => ({ params: { slug: p.path.replace(/^\/|\/$/g, "") || undefined }, props: { key: p.key } }));
}
const { key } = Astro.props;
const raws = import.meta.glob("../raw/*.html", { query: "?raw", import: "default", eager: true });
const file = key.replace(/\//g, "__");
const html = raws[`../raw/${file}.html`] as string;
---

<BaseLayout page={key}><Fragment set:html={html} /></BaseLayout>
