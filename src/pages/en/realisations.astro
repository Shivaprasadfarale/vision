---
/** Our workspace projects | Ronnsquare — /en/realisations/ */
import BaseLayout from "~/layouts/BaseLayout.astro";
import ProjectsHero from "~/components/blocks/block-6-1-hero.astro";
import { hero as heroData } from "~/data/blocks/block-6-1-hero";
import Projects from "~/components/blocks/block-1-8-projects.astro";
import { projects as projectsData } from "~/data/blocks/block-1-8-projects";
import Quote from "~/components/blocks/block-1-3-quote.astro";
import { quote as quoteData } from "~/data/blocks/block-1-3-quote";
import CardReviews from "~/components/blocks/block-1-9-card-reviews.astro";
import { cardReviews as cardReviewsData } from "~/data/blocks/block-1-9-card-reviews";
import CtaSocial from "~/components/blocks/block-1-12-cta-social.astro";
import { ctaSocial as ctaSocialData } from "~/data/blocks/block-1-12-cta-social";
---

<BaseLayout page="realisations">
  <ProjectsHero {...heroData["realisations/01"]} />
  <Projects {...projectsData["realisations/02"]} />
  <Quote {...quoteData["realisations/03"]} />
  <CardReviews {...cardReviewsData["realisations/04"]} />
  <CtaSocial {...ctaSocialData["realisations/05"]} />
</BaseLayout>
