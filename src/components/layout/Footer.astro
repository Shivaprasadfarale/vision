          <div class="footer-ronn__map-group">
            <h3 class="footer-ronn__map-group-title">Presence in 6 European countries</h3>
            <p class="footer-ronn__map-group-text">
              France<br />
              Germany<br />
              Spain<br />
              Italy<br />
              Ireland<br />
              United Kingdom
            </p>
          </div>
        </div>
      </div>
    </section>

