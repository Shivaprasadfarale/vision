          />
        </div>

        <div class="footer-ronn__map-info">
          <div class="footer-ronn__map-group footer-ronn__map-group--office">
            <h3 class="footer-ronn__map-group-title">Head Office – Paris</h3>
            <p class="footer-ronn__map-group-text">
              25 rue du 4 Septembre<br />
              75002 Paris
            </p>
