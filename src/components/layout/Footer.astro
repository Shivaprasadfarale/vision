    <section class="footer-ronn__map">
      <h2 class="footer-ronn__map-title">Based in Paris, operating across Europe</h2>

      <div class="footer-ronn__map-row">
        <div class="footer-ronn__map-image">
          <img
            width="1024"
            height="276"
            src="/assets/uploads/2026/06/Footer-map-1024x276.png"
            class="attachment-large size-large"
            alt="Map of Europe - Ronnsquare's areas of operation"
            sizes="auto, (min-width: 48em) min(1375px, calc(100vw - 429px)), calc(100vw - 20px)"
            loading="lazy"
            decoding="async"
            srcset="
              /assets/uploads/2026/06/Footer-map-1024x276.png 1024w,
              /assets/uploads/2026/06/Footer-map-300x81.png    300w,
              /assets/uploads/2026/06/Footer-map-768x207.png   768w,
              /assets/uploads/2026/06/Footer-map.png          1481w
