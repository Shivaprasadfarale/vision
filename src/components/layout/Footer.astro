          25 rue du 4 Septembre<br />
          75002 Paris
        </p>
      </div>

      <!-- Mobile-only: newsletter -->
      <div class="footer-ronn__mobile-newsletter">
        <span class="footer-ronn__newsletter-label">Newsletter signup</span>
        <form class="footer-ronn__newsletter-form" novalidate="">
          <div class="footer-ronn__newsletter-row">
            <label for="footer-email-mobile" class="sr-only">Email</label>
            <input
              type="email"
              id="footer-email-mobile"
              name="email"
              class="footer-ronn__newsletter-input"
              placeholder="Email"
              autocomplete="email"
              required=""
              pattern="[^@\s]+@[^@\s]+\.[^@\s]+"
              aria-describedby="rs-nl-err-mobile"
              data-error-required="Please enter your email."
              data-error-type="Please enter a valid email."
              data-error-pattern="Please enter a valid email."
            />
            <button type="submit" class="footer-ronn__newsletter-btn" aria-label="Subscribe to newsletter">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M5 12H19M19 12L12 5M19 12L12 19"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
            </button>
          </div>
          <span class="field-error field-error--footer" id="rs-nl-err-mobile" data-field-error="" role="alert" aria-live="polite"></span>

          <div class="form-honeypot" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="footer-ronn__newsletter-consent" data-consent-gate="" hidden="">
            <label class="checkbox checkbox--footer">
              <input
                class="checkbox__input"
                type="checkbox"
                name="consent_privacy"
                id="footer-consent-mobile"
                required=""
                aria-describedby="rs-nl-consent-err-mobile"
                data-error-required="Please accept the Privacy Policy."
              />
              <span class="checkbox__box" aria-hidden="true">
                <svg viewBox="0 0 12 12" fill="none">
                  <path
                    d="M2.5 6L5 8.5 9.5 4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </span>
              <span class="checkbox__label"
                >I accept Ronnsquare's <a class="consent-link" href="/en/privacy-policy/" data-privacy-open="">Privacy Policy</a>. It is
                also protected by reCAPTCHA and the Google
                <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a> and
                <a href="https://policies.google.com/terms" target="_blank" rel="noopener noreferrer">Terms of Service</a> apply.</span
              >
            </label>
            <span
              class="field-error field-error--footer"
              id="rs-nl-consent-err-mobile"
              data-field-error=""
              role="alert"
              aria-live="polite"
            ></span>
          </div>
        </form>
      </div>

