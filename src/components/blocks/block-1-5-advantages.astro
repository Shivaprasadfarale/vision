---
/**
 * Block 1-5 — advantages. Cards reveal on scroll while the central totem
 * sways (src/scripts/blocks/block-1-5-advantages.js).
 */
import type { AdvantagesProps, AdvantageItem } from "../../data/blocks/block-1-5-advantages";

type Props = AdvantagesProps;
const { title, left, right } = Astro.props;
const columns: [string, AdvantageItem[]][] = [
  ["left", left],
  ["right", right],
];
---

<section class="block-1-5-advantages" data-block="block-1-5-advantages">
  <h2 class="block-1-5-advantages__title anim-hidden" data-anim="title">{title}</h2>

  <div class="block-1-5-advantages__body">
    {
      columns.map(([side, items]) => (
        <>
          <div class:list={["block-1-5-advantages__col", `block-1-5-advantages__col--${side}`]}>
            {items.map((item) => (
              <article class="block-1-5-advantages__item anim-hidden" data-anim="card">
                <div class="block-1-5-advantages__badge" aria-hidden="true">
                  {item.badge === "circle" && (
                    <svg viewBox="0 0 51 51" fill="none">
                      <circle cx="25.5" cy="25.5" r="25.5" fill="currentColor" />
                    </svg>
                  )}
                  {item.badge === "half-circle" && (
                    <svg viewBox="0 0 51 25.5" fill="none">
                      <path d="M0 25.5C0 11.42 11.42 0 25.5 0C39.58 0 51 11.42 51 25.5" fill="currentColor" />
                    </svg>
                  )}
                  {item.badge === "square" && (
                    <svg viewBox="0 0 51 51" fill="none">
                      <rect width="51" height="51" fill="currentColor" />
                    </svg>
                  )}
                  {item.badge === "triangle" && (
                    <svg viewBox="0 0 51 25.5" fill="none">
                      <path d="M0 25.5L25.5 0L51 25.5H0Z" fill="currentColor" />
                    </svg>
                  )}
                  {item.badge === "diamond" && (
                    <svg viewBox="0 0 51 51" fill="none">
                      <path d="M25.5 0L51 25.5L25.5 51L0 25.5Z" fill="currentColor" />
                    </svg>
                  )}
                  {item.badge === "rectangle" && (
                    <svg viewBox="0 0 51 30" fill="none">
                      <rect width="51" height="30" fill="currentColor" />
                    </svg>
                  )}
                </div>
                <h3 class="block-1-5-advantages__item-title">{item.title}</h3>
                <p class="block-1-5-advantages__item-desc">{item.desc}</p>
              </article>
            ))}
          </div>

          {side === "left" && (
            <div class="block-1-5-advantages__totem-rail">
              <div class="block-1-5-advantages__totem" data-anim="totem" aria-hidden="true">
                <svg class="equilibre-totem" viewBox="-120 -30 524 641" overflow="visible" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <g class="equilibre-totem__sway" data-shape="sway">
                    <g class="equilibre-totem__diamond" data-shape="diamond">
                      <path
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d="M141.1.9L.9,143.2l142,140.4,140.1-142.2L141.1.9ZM142.5,219.2l-77.4-76.5,76.3-77.5,77.4,76.5-76.3,77.5Z"
                        fill="currentColor"
                      />
                    </g>
                    <g class="equilibre-totem__circle" data-shape="circle">
                      <path
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d="M142.9,283.3c-72.2.5-130.5,59.7-130,131.9.5,72.3,59.6,130.7,131.7,130.2,72.2-.5,130.5-59.7,130-131.9-.5-72.3-59.6-130.7-131.7-130.2ZM144.3,500.7c-47.5.3-86.5-38.2-86.8-85.8-.3-47.6,38.1-86.6,85.6-86.9,47.5-.3,86.5,38.2,86.8,85.8.3,47.6-38.1,86.6-85.6,86.9Z"
                        fill="currentColor"
                      />
                    </g>
                  </g>
                  <g class="equilibre-totem__triangle" data-shape="triangle">
                    <path d="M207.91 611L141.875 544.856L75.8398 611H207.91Z" fill="currentColor" />
                  </g>
                </svg>
              </div>
            </div>
          )}
        </>
      ))
    }
  </div>
</section>
