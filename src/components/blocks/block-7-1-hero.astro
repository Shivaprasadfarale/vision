---
/**
 * Block 7-1 — case-study hero. An infinite photo ticker (the set is rendered twice
 * for a seamless loop; the copy is aria-hidden but still opens the lightbox), arrow
 * controls, project title/subtitle and key facts. Animated by
 * src/scripts/blocks/block-7-1-hero.js through the data-anim* hooks.
 */
import type { HeroProps } from "../../data/blocks/block-7-1-hero";

type Props = HeroProps;
const { title, subtitle, photos, theses } = Astro.props;
const up = (p: string) => `/assets/uploads/${p}`;
---

<section class="block-7-1-hero" data-block="block-7-1-hero" data-entrance="above-fold" aria-label={title}>
  <div class="block-7-1-hero__slider">
    <div class="block-7-1-hero__ticker anim-hidden" data-anim="ticker">
      <div class="block-7-1-hero__track" data-anim="track">
        {
          photos.map((p, i) => (
            <div
              class="block-7-1-hero__item"
              role="button"
              tabindex="0"
              data-lightbox-full={up(p.src)}
              data-lightbox-alt={p.alt}
              aria-label={`Enlarge image ${i + 1}`}
            >
              <div class="block-7-1-hero__item-img">
                <img src={up(p.large ?? p.src)} alt={p.alt} loading={i === 0 ? "eager" : "lazy"} />
              </div>
            </div>
          ))
        }
        {/* Duplicate set for seamless loop — clickable for the lightbox too (JS dedupes the cycle by URL), but hidden from the a11y tree */}
        {
          photos.map((p) => (
            <div class="block-7-1-hero__item" aria-hidden="true" data-lightbox-full={up(p.src)} data-lightbox-alt={p.alt}>
              <div class="block-7-1-hero__item-img">
                <img src={up(p.large ?? p.src)} alt="" loading="lazy" />
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <button class="block-7-1-hero__arrow block-7-1-hero__arrow--prev anim-hidden" data-anim="arrow-prev" aria-label="Previous image">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M19 12H5M5 12L12 5M5 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <button class="block-7-1-hero__arrow block-7-1-hero__arrow--next anim-hidden" data-anim="arrow-next" aria-label="Next image">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
  <div class="block-7-1-hero__text">
    <h1 class="block-7-1-hero__title anim-hidden" data-anim="title">{title}</h1>
    <p class="block-7-1-hero__subtitle anim-hidden" data-anim="subtitle">{subtitle}</p>
  </div>
  <div class="block-7-1-hero__theses-wrapper">
    <div class="block-7-1-hero__theses anim-hidden" data-anim="theses">
      {
        theses.map((t) => (
          <div class="block-7-1-hero__thesis anim-hidden" data-anim="thesis">
            <span class="block-7-1-hero__thesis-label">{t.label}</span>
            <span class="block-7-1-hero__thesis-value">{t.value}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
