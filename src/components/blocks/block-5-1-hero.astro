---
/**
 * Block 5-1 — DNA & Team hero: title, key stats, description, scroll-next CTA
 * and an infinite photo ticker with lightbox (animations: src/scripts/blocks/block-5-1-hero.js).
 * The photo set is rendered twice; the second copy is aria-hidden for the seamless loop.
 */
import Button from "../ui/Button.astro";
import type { DnaHeroProps } from "../../data/blocks/block-5-1-hero";

type Props = DnaHeroProps;
const { title, stats, description, button, photos } = Astro.props;
const up = (p: string) => `/assets/uploads/${p}`;
---

<section class="block-5-1-hero" data-block="block-5-1-hero" data-entrance="above-fold" aria-label={title}>
  <h1 class="block-5-1-hero__title anim-hidden" data-anim="title">{title}</h1>
  <div class="block-5-1-hero__content">
    <div class="block-5-1-hero__stats anim-hidden" data-anim="stats">
      {
        stats.map((stat) => (
          <div class="block-5-1-hero__stat">
            <span class="block-5-1-hero__diamond" aria-hidden="true" />
            <span>{stat}</span>
          </div>
        ))
      }
    </div>
    <div class="block-5-1-hero__desc anim-hidden" data-anim="desc">
      <p>{description}</p>
    </div>
    <div class="block-5-1-hero__cta anim-hidden" data-anim="cta">
      <Button href="#" label={button} class="btn--maron btn--lg block-5-1-hero__btn" data-scroll-next="" />
    </div>
  </div>
  <div class="block-5-1-hero__slider">
    <div class="block-5-1-hero__ticker anim-hidden" data-anim="ticker">
      <div class="block-5-1-hero__track" data-anim="track">
        {
          photos.map((photo, i) => (
            <div
              class="block-5-1-hero__item"
              role="button"
              tabindex="0"
              data-lightbox-full={up(photo.full)}
              data-lightbox-alt={photo.alt}
              aria-label={`Enlarge image ${i + 1}`}
            >
              <div class="block-5-1-hero__item-img">
                <img src={up(photo.thumb)} alt={photo.alt} loading={i === 0 ? "eager" : "lazy"} />
              </div>
            </div>
          ))
        }
        <!-- Duplicate set for seamless loop — clickable for the lightbox too
           (JS dedupes the cycle by URL), but hidden from the a11y tree -->
        {
          photos.map((photo) => (
            <div class="block-5-1-hero__item" aria-hidden="true" data-lightbox-full={up(photo.full)} data-lightbox-alt={photo.alt}>
              <div class="block-5-1-hero__item-img">
                <img src={up(photo.thumb)} alt="" loading="lazy" />
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <button class="block-5-1-hero__arrow block-5-1-hero__arrow--prev anim-hidden" data-anim="arrow-prev" aria-label="Previous image">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M19 12H5M5 12L12 5M5 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <button class="block-5-1-hero__arrow block-5-1-hero__arrow--next anim-hidden" data-anim="arrow-next" aria-label="Next image">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</section>
