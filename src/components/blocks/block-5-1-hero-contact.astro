---
/**
 * Block 5-1 (contact) — contact hero: coordinates with copy-to-clipboard buttons,
 * social link, CTA buttons and the enquiry form (client-side validation reads the
 * data-error-* messages; consent gate, honeypot and totem are driven by
 * src/scripts/blocks/block-5-1-hero-contact.js).
 */
import Button from "../ui/Button.astro";
import type { ContactHeroProps, ContactField } from "../../data/blocks/block-5-1-hero-contact";

type Props = ContactHeroProps;
const { heading, coordTitle, address, hours, email, phone, social, formButton, callbackButton, formTitle, rows, consent, submitLabel } =
  Astro.props;
const ariaLabel = heading.replace(/<[^>]*>/g, "");
const copyables = [
  { coord: "email", href: `mailto:${email.value}`, ...email },
  { coord: "phone", href: `tel:${phone.value.replace(/\s+/g, "")}`, ...phone },
];
const rowClass = (mods: string[]) => ["block-5-1-hero-contact__form-row", ...mods.map((m) => `block-5-1-hero-contact__form-row--${m}`)];
const fieldAttrs = (f: ContactField) => ({
  name: f.name,
  placeholder: f.placeholder,
  "aria-label": f.placeholder,
  autocomplete: f.autocomplete,
  inputmode: f.inputmode,
  required: f.required || undefined,
  pattern: f.pattern,
  "aria-describedby": f.errors ? `rs-err-${f.name}` : undefined,
  "data-error-required": f.errors?.required,
  "data-error-type": f.errors?.type,
  "data-error-pattern": f.errors?.pattern,
});
---

<section class="block-5-1-hero-contact" data-block="block-5-1-hero-contact" data-entrance="above-fold" aria-label={ariaLabel}>
  <div class="block-5-1-hero-contact__info">
    <div class="block-5-1-hero-contact__head">
      <h1 class="block-5-1-hero-contact__heading anim-hidden" data-anim="title" set:html={heading} />
      <p class="block-5-1-hero-contact__coord-title anim-hidden" data-anim="coord-title">{coordTitle}</p>
    </div>

    <div class="block-5-1-hero-contact__coords anim-hidden" data-anim="coords">
      <div class="block-5-1-hero-contact__coord-item" data-coord="siege">
        <span class="block-5-1-hero-contact__coord-label">{address.label}</span>
        <div class="block-5-1-hero-contact__value-row">
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address.value)}`}
            target="_blank"
            rel="noopener"
            class="block-5-1-hero-contact__coord-value block-5-1-hero-contact__coord-value--link">{address.value}</a
          >
          <button class="block-5-1-hero-contact__copy-btn" type="button" data-copy={address.value} aria-label={address.copyLabel}>
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <rect x="5" y="5" width="13" height="13" rx="3" stroke="currentColor" stroke-width="1.4"></rect>
              <rect x="2" y="2" width="13" height="13" rx="3" stroke="currentColor" stroke-width="1.4"></rect>
            </svg>
            <span class="block-5-1-hero-contact__copy-label" aria-hidden="true">Copied</span>
          </button>
        </div>
      </div>

      <!-- Horaires -->
      <div class="block-5-1-hero-contact__coord-item" data-coord="hours">
        <span class="block-5-1-hero-contact__coord-label">{hours.label}</span>
        <span class="block-5-1-hero-contact__coord-value">{hours.value}</span>
      </div>

      {
        copyables.map((c) => (
          <div class="block-5-1-hero-contact__coord-item" data-coord={c.coord}>
            <span class="block-5-1-hero-contact__coord-label">{c.label}</span>
            <div class="block-5-1-hero-contact__value-row">
              <a href={c.href} class="block-5-1-hero-contact__coord-value block-5-1-hero-contact__coord-value--link">
                {c.value}
              </a>
              <button class="block-5-1-hero-contact__copy-btn" type="button" data-copy={c.value} aria-label={c.copyLabel}>
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <rect x="5" y="5" width="13" height="13" rx="3" stroke="currentColor" stroke-width="1.4" />
                  <rect x="2" y="2" width="13" height="13" rx="3" stroke="currentColor" stroke-width="1.4" />
                </svg>
                <span class="block-5-1-hero-contact__copy-label" aria-hidden="true">
                  Copied
                </span>
              </button>
            </div>
          </div>
        ))
      }

      <!-- Social — same source as the footer (footer_social); only networks with a URL set render -->
      <div class="block-5-1-hero-contact__coord-item block-5-1-hero-contact__coord-item--social" data-coord="social">
        <a href={social.href} class="block-5-1-hero-contact__social-link" target="_blank" rel="noopener noreferrer" aria-label={social.label}>
          <span class="block-5-1-hero-contact__social-icon" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
              <rect width="40" height="40" rx="6" fill="currentColor"></rect>
              <path d="M10 15.5H15V30H10V15.5Z" fill="var(--color-brand-sable)"></path>
              <circle cx="12.5" cy="11" r="2.8" fill="var(--color-brand-sable)"></circle>
              <path
                d="M18 15.5H22.5V17.5C23.5 16 25.2 15 27.5 15C31.5 15 33 17.8 33 21.5V30H28V22.5C28 20.8 27.2 19.5 25.5 19.5C23.8 19.5 23 20.8 23 22.5V30H18V15.5Z"
                fill="var(--color-brand-sable)"></path>
            </svg>
          </span>
          <span class="block-5-1-hero-contact__social-label">{social.label}</span>
        </a>
      </div>
    </div>

    <div class="block-5-1-hero-contact__btn-group anim-hidden" data-anim="callback-btn">
      <Button
        href="#contact-form"
        label={formButton}
        class="btn--maron btn--lg block-5-1-hero-contact__form-btn"
        data-scroll-next=""
        data-scroll-target="#contact-form"
      />
      <Button href="#callpage" label={callbackButton} class="btn--lg block-5-1-hero-contact__callback-btn" />
    </div>
  </div>

  <div class="block-5-1-hero-contact__form-panel" id="contact-form">
    <p class="block-5-1-hero-contact__form-title anim-hidden" data-anim="form-intro">{formTitle}</p>

    <form class="block-5-1-hero-contact__form anim-hidden" data-anim="form" action="#" method="post" novalidate="">
      {
        rows.map((row) => (
          <div class:list={rowClass(row.modifiers)}>
            {row.fields.map((f) => (
              <div class="block-5-1-hero-contact__field">
                {f.tag === "textarea" ? <textarea rows={f.rows} {...fieldAttrs(f)} /> : <input type={f.type} {...fieldAttrs(f)} />}
                {f.errors && <span class="field-error" id={`rs-err-${f.name}`} data-field-error="" role="alert" aria-live="polite" />}
              </div>
            ))}
          </div>
        ))
      }

      <div class="form-honeypot" aria-hidden="true">
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div class="block-5-1-hero-contact__consents">
        <div class="block-5-1-hero-contact__consent" data-consent-gate="" hidden="">
          <label class="checkbox checkbox--maron">
            <input
              class="checkbox__input"
              type="checkbox"
              name="consent_privacy"
              required=""
              aria-describedby="rs-err-consent-privacy"
              data-error-required={consent.error}
            />
            <span class="checkbox__box" aria-hidden="true">
              <svg viewBox="0 0 12 12" fill="none">
                <path d="M2.5 6L5 8.5 9.5 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
            <span class="checkbox__label" set:html={consent.label} />
          </label>
          <span class="field-error" id="rs-err-consent-privacy" data-field-error="" role="alert" aria-live="polite"></span>
        </div>
      </div>

      <div class="block-5-1-hero-contact__form-footer">
        <button class="btn btn--maron btn--lg block-5-1-hero-contact__submit-btn" type="submit" data-button-animate-chars="">
          <span class="btn__bg" aria-hidden="true"></span><span class="btn__label">{submitLabel}</span>
        </button>
      </div>
    </form>

    <div class="block-5-1-hero-contact__totem anim-hidden" data-anim="totem" aria-hidden="true">
      <svg class="seo-totem" viewBox="-157 -199 228 270" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <g data-seo-part="move">
          <g data-seo-part="spin">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              fill="currentColor"
              d="M37.49 59.95C4.43 80.62 -39.28 70.55 -59.95 37.49C-80.62 4.43 -70.55 -39.28 -37.49 -59.95C-4.43 -80.62 39.28 -70.55 59.95 -37.49C80.62 -4.43 70.55 39.28 37.49 59.95ZM24.7 39.49C46.47 25.88 53.11 -2.92 39.49 -24.7C25.88 -46.47 -2.92 -53.11 -24.7 -39.49C-46.47 -25.87 -53.11 2.92 -39.49 24.7C-25.87 46.47 2.92 53.11 24.7 39.49Z"
            ></path>
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              fill="currentColor"
              transform="translate(-74.29 -126.48)"
              d="M40.42 64.63L-64.63 40.42L-40.42 -64.63L64.63 -40.42L40.42 64.63ZM22.02 35.21L35.21 -22.02L-22.02 -35.21L-35.21 22.02L22.02 35.21Z"
            ></path>
          </g>
        </g>
      </svg>
    </div>
  </div>
</section>
