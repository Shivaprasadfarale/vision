---
/**
 * Block 1-4 — concern cards grid. Title and card bodies reveal on scroll;
 * the shapes/illustrations animate via src/scripts/blocks/block-1-4-preoccupations.js.
 */
import Button from "../ui/Button.astro";
import type { PreoccupationsProps } from "../../data/blocks/block-1-4-preoccupations";

type Props = PreoccupationsProps;
const { label, titleHtml, headingLevel, variant, ctaLabel, cards } = Astro.props;
const Heading = headingLevel;
const isMedia = variant === "media";
const cutout = "var(--equilibre-cutout-fill, var(--color-brand-parme, #DBB6FC))";
const imgSizes = "auto, (min-width: 75em) 460px, (min-width: 48em) calc(100vw - 80px), calc(100vw - 20px)";
---

<section
  class:list={["block-1-4-preoccupations", { "block-1-4-preoccupations--shapes": !isMedia }, "anim-hidden"]}
  data-block="block-1-4-preoccupations"
  aria-label={label}
>
  <Heading class="block-1-4-preoccupations__title anim-hidden" data-anim="title" set:html={titleHtml} />

  <div class="block-1-4-preoccupations__grid">
    <div class="block-1-4-preoccupations__spacer" aria-hidden="true"></div>

    {
      cards.map((card) => {
        const href = `/en/preoccupations/${card.slug}/`;
        return (
          <article class:list={["block-1-4-preoccupations__card", { "block-1-4-preoccupations__card--shape-media": isMedia }]}>
            <div class="block-1-4-preoccupations__card-top">
              {isMedia ? (
                <div class="block-1-4-preoccupations__card-image anim-hidden" data-anim="image">
                  <div class="block-1-4-preoccupations__card-image-inner" data-anim-img-inner="">
                    <img
                      width="1"
                      height="1"
                      src={`/assets/uploads/${card.image}`}
                      class="attachment-large size-large"
                      alt=""
                      sizes={imgSizes}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </div>
              ) : (
                <div class="block-1-4-preoccupations__card-shape">
                  {card.shape === "square" && (
                    <svg class="equilibre-shape equilibre-shape--square" viewBox="0 0 132 110" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <rect width="132" height="110" fill="currentColor" />
                    </svg>
                  )}
                  {card.shape === "diamond" && (
                    <svg class="equilibre-shape equilibre-shape--diamond" viewBox="0 0 284 284" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M142.929 283.538L0.928784 143.165L141.071 0.93052L283.071 141.304L142.929 283.538Z" fill="currentColor" />
                      <path d="M142.506 219.214L218.853 141.728L141.494 65.2544L65.1467 142.741L142.506 219.214Z" fill={cutout} />
                    </svg>
                  )}
                  {card.shape === "circle" && (
                    <svg class="equilibre-shape equilibre-shape--circle" viewBox="0 0 263 263" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path
                        d="M131.711 262.605C59.5562 263.081 0.475781 204.677 0.000781 132.403C-0.474219 60.1299 57.8334 0.952 129.988 0.476C202.143 0 261.223 58.404 261.698 130.678C262.173 202.951 203.866 262.129 131.711 262.605Z"
                        fill="currentColor"
                      />
                      <path
                        d="M131.417 217.882C178.949 217.569 217.362 178.582 217.049 130.972C216.736 83.362 177.814 44.885 130.282 45.199C82.7503 45.512 44.3369 84.499 44.6499 132.109C44.9629 179.719 83.8853 218.196 131.417 217.882Z"
                        fill={cutout}
                      />
                    </svg>
                  )}
                  {card.shape === "triangle" && (
                    <svg class="equilibre-shape equilibre-shape--triangle" viewBox="0 0 132 67" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M132.07 66.144L66.035 0L0 66.144H132.07Z" fill="currentColor" />
                    </svg>
                  )}
                </div>
              )}
            </div>
            <div class="block-1-4-preoccupations__card-body anim-hidden" data-anim="card-body">
              <h3 class="block-1-4-preoccupations__card-title">
                <a class="block-1-4-preoccupations__card-title-link" href={href}>{card.title}</a>
              </h3>
              <div class="block-1-4-preoccupations__card-bottom">
                <p class="block-1-4-preoccupations__card-desc">{card.desc}</p>
                <div class="block-1-4-preoccupations__card-cta">
                  <Button href={href} label={ctaLabel} class="btn--parme btn--sm" />
                </div>
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>
