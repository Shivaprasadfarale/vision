---
/**
 * Animated FAQ illustration used by the FAQ blocks (block-1-11-faq,
 * block-9-1-faq). The preset name maps to one of three drawings; parts are
 * animated through data-faq-part / data-faq-origin.
 */
import type { FaqAnimation } from "../../data/blocks/block-1-11-faq";

interface Props {
  animation: FaqAnimation;
}
const { animation } = Astro.props;
const variant = animation.startsWith("faq-02") ? "02" : animation.startsWith("faq-03") ? "03" : "01";
const viewBox = { "01": "-64 -85 492 431", "02": "-47 -49 492 431", "03": "0 0 492 431" }[variant];
---

<svg class:list={["faq-illustration", `faq-illustration--${variant}`]} viewBox={viewBox} fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  {
    variant === "01" && (
      <>
        {/* Triangle base — static (painted first, sits behind the bowl) */}
        <path d="M109.832 346.095H253.523L181.677 284.533L109.832 346.095Z" fill="currentColor" />
        {/* Bowl + ball: tilts ±12° around the bowl's bottom-centre (181.7, 284.5) */}
        <g data-faq-part="main">
          <path
            d="M2.05044 110.428C2.36746 206.272 81.4674 284.471 179.987 285.638C278.507 286.805 359.438 210.502 362.025 114.693L2.05044 110.428Z"
            fill="currentColor"
          />
          {/* Ball (circle + "?"): rolls along the rim, spinning around its own centre */}
          <g data-faq-part="ball">
            <circle cx="182.4" cy="57" r="57.5" fill="currentColor" />
            <g transform="translate(168.2, 34.1)">
              <path
                d="M0 13.6567C0 9.4401 1.17477 6.11509 3.52431 3.68164C5.89482 1.22721 9.35619 0 13.9084 0C18.0201 0 21.45 1.18526 24.1981 3.55577C26.9672 5.92629 28.3518 9.01006 28.3518 12.8071C28.3518 17.4432 26.3589 21.0095 22.373 23.5059L16.7405 27.0616V32.7257H8.6849V22.8765L16.4258 18.2509C17.6215 17.5376 18.4816 16.7509 19.0061 15.8908C19.5305 15.0307 19.7928 14.0028 19.7928 12.8071C19.7928 11.4855 19.2788 10.3631 18.2509 9.4401C17.2439 8.51707 15.7964 8.05556 13.9084 8.05556C12.0833 8.05556 10.6254 8.53805 9.5345 9.50304C8.46463 10.468 7.92969 11.8526 7.92969 13.6567H0ZM8.37023 45.753V36.5332H17.1495V45.753H8.37023Z"
                fill="var(--faq-mark-color, var(--color-brand-maron, #231800))"
              />
            </g>
          </g>
        </g>
      </>
    )
  }
  {
    variant === "02" && (
      <g data-faq-part="pivot" data-faq-origin="199 333">
        <circle cx="199" cy="333" r="49" fill="currentColor" />
        <circle cx="199" cy="142" r="142" fill="currentColor" />
      </g>
    )
  }
  {
    variant === "03" && (
      <g data-faq-part="pivot" data-faq-origin="247.7 289">
        <circle cx="247.7" cy="289" r="142" fill="currentColor" />
        <circle cx="403.2" cy="176.5" r="49" fill="currentColor" />
      </g>
    )
  }
</svg>
